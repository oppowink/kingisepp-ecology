SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-secret-key
SESSION_SECRET=replace-with-a-random-string-at-least-32-characters
APP_URL=https://your-vercel-domain.vercel.app

# Assistant: the old project's adapter, accessed through the server (never expose private keys in JS).
ASSISTANT_ENABLED=true
ASSISTANT_PROVIDER=legacy
ASSISTANT_CHAT_URL=https://openai-yandexgpt-adapter-snowy.vercel.app/v1/chat/completions
ASSISTANT_MODEL=gpt-4o-mini
ASSISTANT_API_KEY=
# Alternatively set ASSISTANT_PROVIDER=yandex and fill these values from your AI Studio account.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_TEXT_MODEL=
YANDEX_VISION_MODEL=
